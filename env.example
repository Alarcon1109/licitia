# Chave da API da Anthropic — obtenha em https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modelo usado para análise dos editais (padrão: Claude 3.5 Sonnet)
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Palavras-chave padrão de busca no PNCP (separadas por vírgula)
# Usadas quando o comando "buscar" é chamado sem --palavras
PNCP_PALAVRAS_CHAVE=Informática,TI,Ar-Condicionado,Manutenção

# UF/Município padrão para filtrar (opcional, deixe em branco para buscar em todo o Brasil)
PNCP_UF=

# Quantos dias à frente considerar como "sessão próxima" para priorização no relatório
DIAS_ALERTA_PRAZO=5

# Nome da sua empresa, usado no rodapé dos relatórios e nas mensagens de abordagem
NOME_EMPRESA=LicitIA
